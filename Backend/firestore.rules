rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      // ─── LETTURA ───
      // Il proprietario del profilo può sempre leggere il proprio documento
      allow get: if (request.auth != null && request.auth.uid == userId) || resource.data.role == 'salone';
      // Query / elenco: solo profili di tipo salone (marketplace e mappa pubblica)
      allow list: if resource.data.role == 'salone';

      // ─── SCRITTURA (SICURA) ───
      // REGOLA CRITICA: Solo il proprietario del documento può modificare il proprio profilo
      allow create: if request.auth != null
                    && request.auth.uid == userId;

      // Update: solo il proprietario, e NON può modificare i campi di ruolo/piano
      allow update: if request.auth != null
                    && request.auth.uid == userId
                    // Impedisci escalation: il campo 'role' non può essere cambiato dopo la creazione
                    && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']))
                    // Impedisci cambio piano senza backend: il campo 'planType' è immutabile client-side
                    && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['planType']));

      // Delete: solo il proprietario può eliminare il proprio account
      allow delete: if request.auth != null
                    && request.auth.uid == userId;
    }

    // Collezione dei saloni
    match /saloni/{salonId} {
      // Profilo pubblico del salone (visibile per la ricerca e prenotazione clienti)
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == salonId;

      // Servizi / trattamenti a listino (pubblici per prenotare)
      match /servizi/{serviceId} {
        allow read: if true;
        allow write: if request.auth != null && request.auth.uid == salonId;
      }

      // CLIENTELA: 100% ISOLATA - Visibile e modificabile SOLO dal salone proprietario
      match /clienti/{clientId} {
        allow read, write: if request.auth != null && (request.auth.uid == salonId || request.auth.uid == clientId);
      }

      // STAFF E TEAM: Visibile solo al salone proprietario
      match /staff/{staffId} {
        allow read, write: if request.auth != null && request.auth.uid == salonId;
      }

      // INVITI COLLABORATORI: Visibili e gestibili solo dal salone proprietario
      match /inviti/{inviteId} {
        allow read, write: if request.auth != null && request.auth.uid == salonId;
      }

      // NOTIFICHE SALONE: Solo il salone
      match /notifiche/{notifId} {
        allow read, write: if request.auth != null && request.auth.uid == salonId;
      }

      // APPUNTAMENTI DEL SALONE: Visibili al salone proprietario e al cliente proprietario della prenotazione
      match /appuntamenti/{appId} {
        allow read: if request.auth != null && (
          request.auth.uid == salonId ||
          resource.data.salonRawId == request.auth.uid ||
          resource.data.tenantId == request.auth.uid ||
          resource.data.customerId == request.auth.uid ||
          (resource.data.customer != null && resource.data.customer.id == request.auth.uid) ||
          (resource.data.customer != null && resource.data.customer.email != null && resource.data.customer.email == request.auth.token.email)
        );
        allow create: if request.auth != null;
        allow update, delete: if request.auth != null && (
          request.auth.uid == salonId ||
          resource.data.salonRawId == request.auth.uid ||
          resource.data.tenantId == request.auth.uid ||
          resource.data.customerId == request.auth.uid ||
          (resource.data.customer != null && resource.data.customer.id == request.auth.uid)
        );
      }
    }

    // Collezione globale ridondante appuntamenti (/appointments/{appId})
    match /appointments/{appId} {
      allow read: if request.auth != null && (
        resource.data.salonRawId == request.auth.uid ||
        resource.data.tenantId == request.auth.uid ||
        resource.data.customerId == request.auth.uid ||
        (resource.data.customer != null && resource.data.customer.id == request.auth.uid) ||
        (resource.data.customer != null && resource.data.customer.email != null && resource.data.customer.email == request.auth.token.email)
      );
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && (
        resource.data.salonRawId == request.auth.uid ||
        resource.data.tenantId == request.auth.uid ||
        resource.data.customerId == request.auth.uid ||
        (resource.data.customer != null && resource.data.customer.id == request.auth.uid)
      );
    }

    // Invio email (utilizzato per inviti staff ed estensioni mail)
    match /mail/{mailId} {
      allow create: if request.auth != null;
      allow read: if request.auth != null;
    }
  }
}
